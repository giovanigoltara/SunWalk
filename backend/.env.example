# SunWalk Backend Configuration
# Copy this to .env and fill in your values

# App settings
DEBUG=true
APP_NAME="SunWalk API"

# CORS - add your frontend URLs
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (optional for MVP, needed for caching)
# DATABASE_URL=postgresql://user:password@localhost:5432/sunwalk

# Redis (optional for MVP, needed for caching)
# REDIS_URL=redis://localhost:6379

# Geospatial defaults
DEFAULT_CRS=EPSG:4326
METRIC_CRS=EPSG:25833
SHADOW_RESOLUTION_M=2.0
